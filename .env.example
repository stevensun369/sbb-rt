# Existing SBB feed credentials
TOKEN=replace-with-opentransportdata-token
TOKEN_SA=replace-with-secondary-token

# APNs provider configuration. Leave APNS_ENABLED=false to keep log-only mode.
APNS_ENABLED=false
APNS_TEAM_ID=replace-with-apple-team-id
APNS_KEY_ID=replace-with-apns-key-id
APNS_BUNDLE_ID=com.example.yourapp
APNS_PRIVATE_KEY_FILE=/absolute/path/to/AuthKey_KEYID.p8
APNS_ENVIRONMENT=development
APNS_PUSH_TYPE=alert
APNS_PRIORITY=10
# Device token used by POST /test. Keep this private.
APNS_TEST_DEVICE_TOKEN=replace-with-ios-device-token

# Optional endpoint override for local/mock testing only.
# APNS_ENDPOINT=http://127.0.0.1:9999
